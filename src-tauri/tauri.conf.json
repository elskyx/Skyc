{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skyc",
  "version": "1.0.0",
  "identifier": "com.skyc.downloader",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "Skyc — Media Downloader",
        "width": 1024,
        "height": 720,
        "minWidth": 460,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
